{
  "name": "@fru1tworld/tp",
  "version": "3.0.0",
  "packageManager": "pnpm@11.7.0",
  "description": "Teleport to bookmarked directories",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tp-cli": "dist/index.js"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/index.js',0o755)\"",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/*.ts\" \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "prepublishOnly": "pnpm run build",
    "knip": "knip"
  },
  "keywords": [
    "cli",
    "directory",
    "bookmark",
    "teleport",
    "navigation"
  ],
  "author": "fru1tworld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fru1tworld/tp-cli.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.19.2",
    "execa": "10.0.1",
    "knip": "6.39.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "tp.bash",
    "tp.zsh",
    "tp.nu",
    "tp.fish"
  ]
}
