#compdef diff-tui

local curcontext="$curcontext" state state_descr
local -a line branches
local -A opt_args

_arguments -C -s \
  '(-h --help)'{-h,--help}'[도움말 표시]' \
  '(-V --version)'{-V,--version}'[버전 표시]' \
  '(-C --repo)-C+[저장소 디렉터리]:directory:_directories' \
  '(-C --repo)--repo=[저장소 디렉터리]:directory:_directories' \
  '(--unstaged 1 2)--staged[스테이징된 변경 표시]' \
  '(--staged 1 2)--unstaged[스테이징 안 된 변경 표시]' \
  '(-t --show-tests)'{-t,--show-tests}'[테스트 파일 표시]' \
  '--unified[통합 보기 사용]' \
  '(--staged --unstaged)1:branch:->branches' \
  '(--staged --unstaged)2:branch:->branches' && return

[[ $state == branches ]] || return 1

local repo=${opt_args[-C]:-${opt_args[--repo]:-.}}
repo=${(Q)repo}
[[ $repo == '~/'* ]] && repo="$HOME/${repo[3,-1]}"
local refs
refs=$(command git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads/ refs/remotes/ 2>/dev/null) || return 1
[[ -n $refs ]] || return 1
branches=(HEAD "${(@f)refs}")
_describe 'branch' branches
