#compdef diff-tui

local curcontext="$curcontext" state state_descr
local -a line branches
local -A opt_args

_arguments -C -s \
  '(-h --help)'{-h,--help}'[Show help]' \
  '(-V --version)'{-V,--version}'[Show version]' \
  '-C+[Repository directory]:directory:_directories' \
  '(--unstaged 1 2)--staged[Show staged changes]' \
  '(--staged 1 2)--unstaged[Show unstaged changes]' \
  '(-t --show-tests)'{-t,--show-tests}'[Show test files]' \
  '--unified[Use unified view]' \
  '(--staged --unstaged)1:branch:->branches' \
  '(--staged --unstaged)2:branch:->branches' && return

[[ $state == branches ]] || return 1

local repo=${(Q)opt_args[-C]:-.}
local refs
refs=$(command git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads/ refs/remotes/ 2>/dev/null) || return 1
[[ -n $refs ]] || return 1
branches=(HEAD "${(@f)refs}")
_describe 'branch' branches
